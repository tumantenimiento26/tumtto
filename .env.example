# Supabase (browser client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App Links / deep links a la app móvil.
# Paquete Android (applicationId).
NEXT_PUBLIC_ANDROID_PACKAGE=com.tumttomobile
# SHA-256 del certificado de firma, separados por coma. Con Play App Signing
# usa el de Play Console › Integridad de la app. El de debug de React Native es:
# FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C
ANDROID_SHA256_CERT_FINGERPRINTS=
# Tiendas (vacío hasta publicar; sin ellas el respaldo es el registro web).
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Contacto público (landing, footer, aviso de privacidad). Cada canal vacío se
# oculta; el correo tiene valor por defecto. Ver src/lib/contact.ts.
# TODO(confirmar con Tu Mantenimiento) antes de publicar.
# WhatsApp y teléfono: 10 dígitos MX, con o sin +52 (ej. 5233 1234 5678).
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_WHATSAPP_MESSAGE=
NEXT_PUBLIC_CONTACT_PHONE=
# Por defecto soporte@tumantenimiento.mx.
NEXT_PUBLIC_CONTACT_EMAIL=
# Redes: URL https completa.
NEXT_PUBLIC_CONTACT_FACEBOOK=
NEXT_PUBLIC_CONTACT_INSTAGRAM=
NEXT_PUBLIC_CONTACT_TIKTOK=
NEXT_PUBLIC_CONTACT_LINKEDIN=
NEXT_PUBLIC_CONTACT_YOUTUBE=
NEXT_PUBLIC_CONTACT_X=
